{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build current example",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "${fileDirname}/.."
            ],
            "group": {
                "kind": "build"
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Clean current example",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "${fileDirname}/..",
                "clean"
            ],
            "group": "build",
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Run current program",
            "type": "shell",
            "command": "${fileDirname}/../bin/program.exe",
            "dependsOn": "Build current example",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}